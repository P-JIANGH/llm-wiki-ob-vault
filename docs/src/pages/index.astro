---
import WikiLayout from '../layouts/WikiLayout.astro';
import { loadAllPages } from '../lib/vault';

const allPages = loadAllPages();
const bySection = allPages.reduce((acc, p) => {
  if (!acc[p.section]) acc[p.section] = [];
  acc[p.section].push(p);
  return acc;
}, {} as Record<string, typeof allPages>);

const sectionMeta: Record<string, { icon: string; label: string; desc: string }> = {
  entities:          { icon: '🏢', label: '实体', desc: 'AI 工具、框架与项目' },
  concepts:          { icon: '💡', label: '概念', desc: '架构模式与技术概念' },
  comparisons:       { icon: '⚖️', label: '对比', desc: '工具与方案对比分析' },
  queries:           { icon: '🔍', label: '查询', desc: '问题解答与查询记录' },
  raw:               { icon: '📄', label: '原始资料', desc: '原始文章与参考资料' },
};

// Serialize pages for client-side search
const searchData = allPages.map(p => ({
  title: p.title,
  slug: p.slug,
  section: p.section,
  sectionLabel: sectionMeta[p.section]?.label || p.section,
}));
---

<WikiLayout title="首页">
  <div class="home-hero">
    <h1>LLM Wiki</h1>
    <p>Agentic System Designer 知识库 — {allPages.length} 篇文档</p>
  </div>

  <!-- Search -->
  <div class="home-search">
    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" id="homeSearch" placeholder="搜索知识库..." autocomplete="off" />
    <div class="search-results" id="searchResults"></div>
  </div>

  <div class="home-stats">
    {Object.entries(sectionMeta).map(([sec, meta]) => {
      const pages = bySection[sec] || [];
      if (pages.length === 0) return null;
      return (
        <div class="stat-card">
          <span class="stat-icon">{meta.icon}</span>
          <div>
            <span class="stat-count">{pages.length}</span>
            <span class="stat-label">{meta.label}</span>
          </div>
        </div>
      );
    })}
  </div>

  <div class="home-sections">
    {Object.entries(sectionMeta).map(([sec, meta]) => {
      const pages = bySection[sec] || [];
      if (pages.length === 0) return null;
      return (
        <section class="home-section">
          <h2>{meta.icon} {meta.label} <span class="section-count">{pages.length}</span></h2>
          <p class="section-desc">{meta.desc}</p>
          <ul class="page-list">
            {pages.slice(0, 12).map(p => (
              <li>
                <a href={`/${p.slug}`}>{p.title}</a>
              </li>
            ))}
            {pages.length > 12 && <li class="more"><a href={`/${sec}`}>+ 还有 {pages.length - 12} 篇…</a></li>}
          </ul>
        </section>
      );
    })}
  </div>
</WikiLayout>

<script>
  import Fuse from 'fuse.js';

  const searchData = JSON.parse(document.getElementById('search-data')?.textContent || '[]');
  const fuse = new Fuse(searchData, {
    keys: ['title', 'slug'],
    threshold: 0.3,
    includeScore: true,
  });

  const input = document.getElementById('homeSearch') as HTMLInputElement;
  const resultsEl = document.getElementById('searchResults');

  if (input && resultsEl) {
    input.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim();
      if (!query) {
        resultsEl.classList.remove('active');
        resultsEl.innerHTML = '';
        return;
      }

      const results = fuse.search(query).slice(0, 10);
      if (results.length === 0) {
        resultsEl.innerHTML = '<div class="search-result-item"><span class="result-title">未找到相关结果</span></div>';
      } else {
        resultsEl.innerHTML = results.map(r => `
          <a href="/${r.item.slug}" class="search-result-item">
            <div class="result-title">${r.item.title}</div>
            <div class="result-section">${r.item.sectionLabel}</div>
          </a>
        `).join('');
      }
      resultsEl.classList.add('active');
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !resultsEl.contains(e.target as Node)) {
        resultsEl.classList.remove('active');
      }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        resultsEl.classList.remove('active');
        input.blur();
      }
    });
  }
</script>

<script type="application/json" id="search-data">{JSON.stringify(searchData)}</script>

<style>
  .section-count {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-left: 0.5rem;
    background: var(--surface);
    padding: 0.1rem 0.5rem;
    border-radius: 12px;
  }
  .section-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: -0.5rem 0 1rem;
  }
</style>
